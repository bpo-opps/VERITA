# Configurações do servidor em produção. Os valores reais ficam só no painel da hospedagem, nunca no git.

# Primeira execução: cria a organização e o primeiro administrador (a senha temporária aparece no log uma vez).
ADMIN_EMAIL=
ORG_NAME=Opps Consultoria

# Endereço público, usado nos links dos e-mails.
APP_URL=https://tarefas.oppsconsultoria.com

# Já vêm no Dockerfile: fuso de Brasília, HTTPS e proxy da hospedagem.
# TZ=America/Sao_Paulo
# COOKIE_SECURE=1
# TRUST_PROXY=1
# DB_FILE=/app/data/tarefas.db
# BACKUP_DIR=/app/data/backups

# E-mail pelo Google Workspace (senha de app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Painel de Tarefas Opps <avisos@oppsconsultoria.com>

# WhatsApp (API oficial da Meta). Deixe vazio para desligar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Leitura das atas de reunião pela IA. Deixe vazio para lançar à mão.
ANTHROPIC_API_KEY=
